# 仅在服务器复制为 docker/.env.deploy 后再启动服务，并修改数据库密码和 JWT 密钥。
MYSQL_ROOT_PASSWORD=replace-with-a-strong-mysql-password
MYSQL_DATABASE=gozero-admin
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_EXPIRE=7200
APP_JWT_ACCESS_SECRET=replace-with-a-different-random-secret-at-least-32-characters
APP_JWT_ACCESS_EXPIRE=900
APP_JWT_REFRESH_EXPIRE=2592000
# API 仅信任此列表中代理的转发头，填实际代理 IPv4 /32 或 IPv6 /128，多个用逗号分隔；空值不信任。
# 不要填写整个 Docker 网段、宿主网关或客户端网段；代理容器 IP 变化后需重新核实并更新。
APP_TRUSTED_PROXY_CIDRS=
RPC_AUTH_APP=applet-api
RPC_AUTH_TOKEN=replace-with-a-random-rpc-secret-at-least-32-characters
API_PORT=127.0.0.1:7001
# 默认前端仓库与后端并列；也可填前端仓库绝对路径。
# 相对路径以 docker/deploy-compose.yml 所在目录为基准。
FRONTEND_CONTEXT=../../go-zero-admin-vben
WEB_PORT=127.0.0.1:8080

# 以下对象存储配置为可选项；留空时不能使用图片上传功能。
REDIS_PASSWORD=
OSS_ENDPOINT=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
DEFAULT_USER_PASSWORD=replace-with-a-strong-initial-password

# 部署文档代理访问容器内 API
# Swagger 仅在添加 --profile tools 时启动。
SWAGGER_PORT=8081
SWAGGER_API_URL=http://api:7001

# SMTP 可选；RPC 复用现有邮件模块，使用隐式 TLS。
# 开启后邮箱注册必须提交验证码；账号依然需要管理员审核。
APP_EMAIL_VERIFICATION_REQUIRED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# AI Agent 密钥可选；普通配置在 docker/ai-rpc.yaml.template 的 AI 块，默认关闭。
# 容器仅从所选提供商的环境变量 API_KEY_DEEPSEEK / API_KEY_QWEN 读取，不使用 YAML APIKey 兜底。
# 只填写 AI.Provider 所选提供商的密钥；实际值写入 docker/.env.deploy，不提交 Git。
# 此文件仅供 docker/deploy-compose.yml 的 --env-file 使用；根 Compose 不自动加载 docker/.env.deploy。
API_KEY_DEEPSEEK=
API_KEY_QWEN=
