# 演示语料按已冻结的CRLF原始字节检出，题集元数据固定LF以保持跨平台SHA256。
/ai_document/ai-rag/*.json text eol=lf
/ai_document/ai-rag/kb1-a股投资知识/* text eol=crlf
/ai_document/ai-rag/kb2-运维发布SOP/* text eol=crlf
# 实际项目文档摘录按冻结的LF字节检出；JSON沿用上面的元数据规则。
/ai_document/ai-rag/business-docs/*.md text eol=lf
/ai_document/ai-rag/business-cases.md text eol=lf
# 自定义题集互通夹具的SHA针对原始字节，Windows检出不得改写换行。
/go-zero-admin/application/ai/rpc/internal/logic/aiservice/testdata/custom-*.json text eol=lf
# 服务端嵌入题集与对外发布的冻结JSON必须保持同一原始字节指纹。
/go-zero-admin/application/ai/rpc/internal/logic/aiservice/evaluation_data/*.json text eol=lf
# 完整数据库快照保留导出原始字节，避免换行转换导致恢复校验值失真。
/go-zero-admin/data/db/init/20261117/*.sql -text
/go-zero-admin/data/db/init/20261117/*.json text eol=lf
