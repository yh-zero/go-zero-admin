syntax = "v1"

import "../app/types.api"

@server(
    prefix: /v1/sys/app-members
    group: appmembers
    jwt: JwtAuth
    middleware: Authority
)
service applet-api {
    @doc "分页查询 App 用户与待审核账号"
    @handler ListAppUsers
    get /users (AppUserListRequest) returns (AppUserList)

    @doc "审核或禁用恢复 App 账号"
    @handler SetAppUserStatus
    put /status (AppStatusRequest) returns (MessageResponse)

    @doc "更新 App 用户头像，空地址恢复默认头像"
    @handler SetAppUserAvatar
    put /avatar (AppAvatarRequest) returns (MessageResponse)

    @doc "查询 App 用户有效设备"
    @handler ListAppUserSessions
    get /sessions (AppUserIDRequest) returns (AppSessionList)

    @doc "撤销 App 用户设备"
    @handler RevokeAppUserSession
    delete /session (AppSessionIDRequest) returns (MessageResponse)

    @doc "读取会员方案"
    @handler ListAppPlans
    get /plans returns (AppPlanList)

    @doc "分页查询会员授予记录"
    @handler ListAppGrants
    get /grants (AppGrantListRequest) returns (AppGrantList)

    @doc "人工开通或续期会员"
    @handler GrantAppMembership
    post /grants (AppGrantRequest) returns (AppGrant)

    @doc "撤销指定会员授予"
    @handler RevokeAppMembership
    delete /grant (AppGrantRevokeRequest) returns (MessageResponse)
}

