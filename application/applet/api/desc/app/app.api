syntax = "v1"

import "types.api"

@server(
    prefix: /v1/app/auth
    group: appauth
    middleware: AppRequest
)
service applet-api {
    @doc "查询邮箱验证配置"
    @handler GetAppAuthOptions
    get /options returns (AppAuthOptions)

    @doc "发送 App 邮箱注册验证码"
    @handler SendAppEmailCode
    post /email-code (AppSendEmailCodeRequest) returns (MessageResponse)

    @doc "邮箱或手机号注册，等待管理员审核"
    @handler RegisterAppAccount
    post /register (AppRegisterRequest) returns (AppUser)

    @doc "已审核 App 账号登录"
    @handler LoginAppAccount
    post /login (AppLoginRequest) returns (AppAuthTokens)

    @doc "轮换 App 刷新令牌"
    @handler RefreshAppToken
    post /refresh (AppRefreshRequest) returns (AppAuthTokens)
}

@server(
    prefix: /v1/app
    group: appaccount
    jwt: AppJwtAuth
    middleware: AppSession
)
service applet-api {
    @doc "读取本人资料"
    @handler GetAppProfile
    get /me returns (AppUser)

    @doc "更新本人昵称"
    @handler UpdateAppProfile
    put /me (AppProfileRequest) returns (AppUser)

    @doc "退出当前或全部设备"
    @handler LogoutAppAccount
    post /auth/logout (AppLogoutRequest) returns (MessageResponse)

    @doc "查看本人有效设备"
    @handler GetMyAppSessions
    get /sessions returns (AppSessionList)

    @doc "撤销本人设备"
    @handler RevokeMyAppSession
    delete /session (AppSessionIDRequest) returns (MessageResponse)

    @doc "读取当前会员权益"
    @handler GetAppMembership
    get /membership returns (AppMembership)

    @doc "会员示例：导出本人资料"
    @handler GetAppMemberExample
    get /example/profile-export (AppUserIDRequest) returns (AppExample)
}

