syntax = "v1"

info (
	title:   "go-zero-admin"
	desc:    "管理后台统一 API 网关"
	version: "v1"
)

import "sys/auth.api"
import "sys/user.api"
import "sys/dept.api"
import "sys/role.api"
import "sys/file.api"
import "sys/menu.api"
import "sys/dict.api"
import "sys/api.api"
import "sys/audit.api"
import "sys/profile.api"
import "sys/tenant.api"
import "app/app.api"
import "sys/app.api"
import "sys/ai.api"

type PingReq {}

type EmptyResp {}

type ReadyResp {
	Ready bool `json:"ready"`
}

type PingResp {
	Msg string `json:"msg"`
}

@server (
	group: health
)
service admin {
	@handler ping
	get /ping (PingReq) returns (PingResp)

	@handler ready
	get /ready returns (ReadyResp)
}
