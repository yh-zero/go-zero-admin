syntax = "v1"

info (
	title:   "用户管理"
	version: "v1"
)

type (
	UserInfo {
		Id           int64   `json:"id"`
		Username     string  `json:"username"`
		Nickname     string  `json:"nickname"`
		RealName     string  `json:"real_name"`
		Email        string  `json:"email"`
		Phone        string  `json:"phone"`
		DeptId       int64   `json:"dept_id"`
		DeptName     string  `json:"dept_name"`
		AvatarFileId int64   `json:"avatar_file_id"`
		AvatarUrl    string  `json:"avatar_url"`
		Gender       int32   `json:"gender"`
		Status       int32   `json:"status"`
		Remark       string  `json:"remark"`
		LastLoginAt  int64   `json:"last_login_at"`
		LastLoginIp  string  `json:"last_login_ip"`
		CreatedAt    int64   `json:"created_at"`
		UpdatedAt    int64   `json:"updated_at"`
		RoleIds      []int64 `json:"role_ids"`
	}
	GetUserListReq {
		Page     int64  `json:"page,optional" form:"page,optional" validate:"omitempty,min=1"`
		PageSize int64  `json:"page_size,optional" form:"page_size,optional" validate:"omitempty,min=1,max=100"`
		Username string `json:"username,optional" form:"username,optional" validate:"omitempty,max=64"`
		Nickname string `json:"nickname,optional" form:"nickname,optional" validate:"omitempty,max=64"`
		DeptId   int64  `json:"dept_id,optional" form:"dept_id,optional"`
		Status   int32  `json:"status,optional" form:"status,optional" validate:"omitempty,oneof=1 2"`
	}
	GetUserListResp {
		List  []*UserInfo `json:"list"`
		Total int64       `json:"total"`
	}
	GetUserReq {
		Id int64 `path:"id" validate:"min=1"`
	}
	GetUserResp {
		User *UserInfo `json:"user"`
	}
	GetUserPermissionsReq {
		Id int64 `path:"id" validate:"min=1"`
		DeptId *int64 `form:"dept_id,optional" validate:"omitempty,min=0"`
	}
	UserPermissionDept {
		Id int64 `json:"id"`
		Name string `json:"name"`
	}
	UserPermissionRole {
		Code string `json:"code"`
		Domain string `json:"domain"`
		DataScope string `json:"data_scope"`
	}
	UserPermissionVisibleUser {
		Id int64 `json:"id"`
		Username string `json:"username"`
	}
	UserPermissionItem {
		Key string `json:"key"`
		Label string `json:"label"`
		UiGranted bool `json:"ui_granted"`
		UiRoles []string `json:"ui_roles"`
		ApiAllowed bool `json:"api_allowed"`
		ApiRole string `json:"api_role"`
		ApiDomain string `json:"api_domain"`
	}
	GetUserPermissionsResp {
		DeptId int64 `json:"dept_id"`
		Depts []*UserPermissionDept `json:"depts"`
		Enabled bool `json:"enabled"`
		Roles []*UserPermissionRole `json:"roles"`
		Items []*UserPermissionItem `json:"items"`
		DataScopes []string `json:"data_scopes"`
		VisibleUserCount int64 `json:"visible_user_count"`
		VisibleUsers []*UserPermissionVisibleUser `json:"visible_users"`
	}
	ImportUsersReq {
		Csv string `json:"csv" validate:"required,maxbytes=65536"`
		Confirm bool `json:"confirm,optional"`
		RowNumbers []int64 `json:"row_numbers,optional" validate:"omitempty,max=100,dive,min=2"`
	}
	ImportUserRow {
		Row int64 `json:"row"`
		Username string `json:"username"`
		DeptId int64 `json:"dept_id"`
		Status string `json:"status"`
		Message string `json:"message"`
	}
	ImportUsersResp {
		Rows []*ImportUserRow `json:"rows"`
		Created int64 `json:"created"`
	}
	CreateUserReq {
		Username     string  `json:"username" validate:"min=2,max=64"`
		Password     string  `json:"password" validate:"min=8,maxbytes=72"`
		Nickname     string  `json:"nickname,optional" validate:"omitempty,max=64"`
		RealName     string  `json:"real_name,optional" validate:"omitempty,max=64"`
		Email        string  `json:"email,optional" validate:"omitempty,email,max=128"`
		Phone        string  `json:"phone,optional" validate:"omitempty,max=20"`
		DeptId       int64   `json:"dept_id,optional"`
		AvatarFileId int64   `json:"avatar_file_id,optional"`
		Gender       int32   `json:"gender,optional" validate:"omitempty,oneof=0 1 2"`
		Status       int32   `json:"status,optional" validate:"omitempty,oneof=1 2"`
		Remark       string  `json:"remark,optional" validate:"omitempty,max=512"`
		RoleIds      []int64 `json:"role_ids,optional" validate:"omitempty,dive,min=1"`
	}
	UpdateUserReq {
		Id           int64   `path:"id" validate:"min=1"`
		Nickname     *string `json:"nickname,optional" validate:"omitempty,max=64"`
		RealName     *string `json:"real_name,optional" validate:"omitempty,max=64"`
		Email        *string `json:"email,optional" validate:"omitempty,email_or_empty,max=128"`
		Phone        *string `json:"phone,optional" validate:"omitempty,max=20"`
		DeptId       *int64  `json:"dept_id,optional"`
		AvatarFileId *int64  `json:"avatar_file_id,optional"`
		Gender       *int32  `json:"gender,optional" validate:"omitempty,oneof=0 1 2"`
		Status       *int32  `json:"status,optional" validate:"omitempty,oneof=1 2"`
		Remark       *string `json:"remark,optional" validate:"omitempty,max=512"`
		RoleIds      []int64 `json:"role_ids,optional" validate:"omitempty,dive,min=1"`
	}
	DeleteUserReq {
		Id int64 `path:"id" validate:"min=1"`
	}
	ResetPasswordReq {
		Id          int64  `path:"id" validate:"min=1"`
		NewPassword string `json:"new_password" validate:"min=8,maxbytes=72"`
	}
	ChangePasswordReq {
		OldPassword string `json:"old_password" validate:"maxbytes=72"`
		NewPassword string `json:"new_password" validate:"min=8,maxbytes=72"`
	}
)

@server (
	prefix: v1/sys/user
	group:  user
)
service admin {
	@handler getUserList
	get /list (GetUserListReq) returns (GetUserListResp)

	@handler getUser
	get /:id (GetUserReq) returns (GetUserResp)

	@handler getUserPermissions
	get /:id/permissions (GetUserPermissionsReq) returns (GetUserPermissionsResp)

	@handler createUser
	post /create (CreateUserReq) returns (EmptyResp)

	@handler importUsers
	post /import (ImportUsersReq) returns (ImportUsersResp)

	@handler updateUser
	put /:id (UpdateUserReq) returns (EmptyResp)

	@handler deleteUser
	delete /:id (DeleteUserReq) returns (EmptyResp)

	@handler resetPassword
	post /:id/password (ResetPasswordReq) returns (EmptyResp)

	@handler changePassword
	post /password/change (ChangePasswordReq) returns (EmptyResp)
}
