syntax = "v1"

info (
	title:   "AI 会话与工作流"
	version: "v1"
)

type (
	AiConversationInfo {
		Id           int64  `json:"id"`
		Title        string `json:"title"`
		UserId       int64  `json:"user_id"`
		MessageCount int64  `json:"message_count"`
		CreatedAt    int64  `json:"created_at"`
		UpdatedAt    int64  `json:"updated_at"`
		Pinned       bool   `json:"pinned"`
	}
	AiChatMessage {
		Id        int64  `json:"id"`
		Role      string `json:"role"`
		Content   string `json:"content"`
		ToolCalls string `json:"tool_calls"`
		Tokens    int64  `json:"tokens"`
		CreatedAt int64  `json:"created_at"`
		Status    string `json:"status"`
		Error     string `json:"error"`
		Sources   []*AiKbSearchHit `json:"sources"`
		Feedback  string `json:"feedback"`
		FeedbackNote string `json:"feedback_note"`
	}
	AiWorkflowInfo {
		Id              int64  `json:"id"`
		Name            string `json:"name"`
		Definition      string `json:"definition"`
		IntervalSeconds int64  `json:"interval_seconds"`
		Enabled         int64  `json:"enabled"`
		NextRunAt       int64  `json:"next_run_at"`
		CreatedBy       int64  `json:"created_by"`
		CreatedAt       int64  `json:"created_at"`
		UpdatedAt       int64  `json:"updated_at"`
		StepCount       int64  `json:"step_count"`
	}
	AiTaskInfo {
		Id             int64  `json:"id"`
		WorkflowId     int64  `json:"workflow_id"`
		ConversationId int64  `json:"conversation_id"`
		Status         string `json:"status"`
		Input          string `json:"input"`
		Result         string `json:"result"`
		Error          string `json:"error"`
		ApprovedBy     int64  `json:"approved_by"`
		CreatedAt      int64  `json:"created_at"`
		CompletedAt    int64  `json:"completed_at"`
		NextStep       int64  `json:"next_step"`
		Steps          []*AiWorkflowStepInfo `json:"steps"`
		UpdatedAt      int64 `json:"updated_at"`
		RequestId      string `json:"request_id"`
		Title          string `json:"title"`
		WorkflowName   string `json:"workflow_name"`
		InputSummary   string `json:"input_summary"`
		Definition     string `json:"definition"`
	}
	AiWorkflowStepInfo {
		Index int64 `json:"index"`
		Id string `json:"id"`
		Name string `json:"name"`
		Tool string `json:"tool"`
		Input string `json:"input"`
		Status string `json:"status"`
		Output string `json:"output"`
		Error string `json:"error"`
		StartedAt int64 `json:"started_at"`
		CompletedAt int64 `json:"completed_at"`
	}
	AiToolInfo {
		Name             string `json:"name"`
		Description      string `json:"description"`
		ParametersSchema string `json:"parameters_schema"`
	}
	AiIdReq {
		Id int64 `path:"id" validate:"min=1"`
	}
	AiPageReq {
		Page     int64 `form:"page,optional" validate:"omitempty,min=1"`
		PageSize int64 `form:"page_size,optional" validate:"omitempty,min=1,max=100"`
	}
	AiCreateConversationReq {
		Title string `json:"title,optional" validate:"omitempty,max=128"`
	}
	AiListConversationsReq {
		Page int64 `form:"page,optional" validate:"omitempty,min=1"`
		PageSize int64 `form:"page_size,optional" validate:"omitempty,min=1,max=100"`
		Query string `form:"query,optional" validate:"omitempty,max=128"`
	}
	AiUpdateConversationReq {
		Id int64 `path:"id" validate:"min=1"`
		Title *string `json:"title,optional" validate:"omitempty,max=128"`
		Pinned *bool `json:"pinned,optional"`
	}
	AiMessageFeedbackReq {
		Id int64 `path:"id" validate:"min=1"`
		MessageId int64 `path:"message_id" validate:"min=1"`
		Feedback string `json:"feedback" validate:"omitempty,oneof=helpful irrelevant_source missing_knowledge"`
		Note string `json:"note,optional" validate:"omitempty,maxbytes=1000"`
	}
	AiConversationResp {
		Conversation *AiConversationInfo `json:"conversation"`
	}
	AiGetConversationReq {
		Id       int64 `path:"id" validate:"min=1"`
		BeforeId int64 `form:"before_id,optional" validate:"omitempty,min=0"`
		PageSize int64 `form:"page_size,optional" validate:"omitempty,min=0,max=20"`
	}
	AiGetConversationResp {
		Conversation *AiConversationInfo `json:"conversation"`
		Messages     []*AiChatMessage    `json:"messages"`
		HasMore      bool                `json:"has_more"`
		NextBeforeId int64               `json:"next_before_id"`
	}
	AiListConversationsResp {
		List  []*AiConversationInfo `json:"list"`
		Total int64                 `json:"total"`
	}
	AiSendMessageReq {
		RequestId      string `json:"request_id" validate:"required,uuid"`
		ConversationId int64  `json:"conversation_id" validate:"min=0"`
		Content        string `json:"content" validate:"max=16000"`
		KbId           int64 `json:"kb_id,optional" validate:"min=0"`
		Grounded       bool `json:"grounded,optional"`
	}
	AiSendMessageResp {
		ConversationId int64          `json:"conversation_id"`
		Conversation   *AiConversationInfo `json:"conversation"`
		UserMessage    *AiChatMessage `json:"user_message"`
		AiMessage      *AiChatMessage `json:"ai_message"`
	}
	AiListToolsReq  {}
	AiCapabilities {
		RetrievalConfigured bool `json:"retrieval_configured"`
		AnalysisConfigured bool `json:"analysis_configured"`
		IngestionMode string `json:"ingestion_mode"`
	}
	AiListToolsResp {
		List []*AiToolInfo `json:"list"`
		Capabilities *AiCapabilities `json:"capabilities"`
	}
	AiListWorkflowsReq {
		Page int64 `form:"page,optional" validate:"omitempty,min=1"`
		PageSize int64 `form:"page_size,optional" validate:"omitempty,min=1,max=100"`
		Query string `form:"query,optional" validate:"omitempty,max=128"`
	}
	AiCreateWorkflowReq {
		Name            string `json:"name" validate:"max=128"`
		Definition      string `json:"definition" validate:"max=65536"`
		IntervalSeconds int64  `json:"interval_seconds,optional" validate:"omitempty,min=0"`
	}
	AiUpdateWorkflowReq {
		Id              int64   `path:"id" validate:"min=1"`
		Name            *string `json:"name,optional" validate:"omitempty,max=128"`
		Definition      *string `json:"definition,optional" validate:"omitempty,max=65536"`
		IntervalSeconds *int64  `json:"interval_seconds,optional" validate:"omitempty,min=0"`
		Enabled         *int64  `json:"enabled,optional" validate:"omitempty,oneof=0 1"`
	}
	AiWorkflowResp {
		Workflow *AiWorkflowInfo `json:"workflow"`
	}
	AiListWorkflowsResp {
		List  []*AiWorkflowInfo `json:"list"`
		Total int64             `json:"total"`
	}
	AiRunWorkflowReq {
		Id    int64  `path:"id" validate:"min=1"`
		Input string `json:"input,optional" validate:"omitempty,max=16000"`
		RequestId string `json:"request_id" validate:"required,uuid"`
	}
	AiRunWorkflowResp {
		TaskId int64  `json:"task_id"`
		Status string `json:"status"`
	}
	AiRunDraftReq {
		Name string `json:"name" validate:"required,max=128"`
		Definition string `json:"definition" validate:"required,maxbytes=65536"`
		Input string `json:"input,optional" validate:"omitempty,maxbytes=16000"`
		RequestId string `json:"request_id" validate:"required,uuid"`
	}
	AiListTasksReq {
		Page       int64  `form:"page,optional" validate:"omitempty,min=1"`
		PageSize   int64  `form:"page_size,optional" validate:"omitempty,min=1,max=100"`
		Status     string `form:"status,optional" validate:"omitempty,oneof=pending running pending_approval succeeded failed rejected cancelled"`
		WorkflowId int64  `form:"workflow_id,optional" validate:"omitempty,min=1"`
		Query string `form:"query,optional" validate:"omitempty,max=128"`
	}
	AiGetTaskReq {
		Id int64 `path:"id" validate:"min=1"`
		MetaOnly bool `form:"meta_only,optional"`
	}
	AiListTasksResp {
		List  []*AiTaskInfo `json:"list"`
		Total int64         `json:"total"`
	}
	AiTaskResp {
		Task *AiTaskInfo `json:"task"`
	}
	AiApproveTaskReq {
		Id           int64  `path:"id" validate:"min=1"`
		ExpectedStep *int64 `json:"expected_step" validate:"required,min=0"`
	}
	AiRejectTaskReq {
		Id           int64  `path:"id" validate:"min=1"`
		ExpectedStep *int64 `json:"expected_step" validate:"required,min=0"`
		Reason       string `json:"reason" validate:"max=512"`
	}
	AiKbInfo {
		Id          int64  `json:"id"`
		Name        string `json:"name"`
		Description string `json:"description"`
		OwnerId     int64  `json:"owner_id"`
		DocCount    int64  `json:"doc_count"`
		ChunkCount  int64  `json:"chunk_count"`
		CreatedAt   int64  `json:"created_at"`
		UpdatedAt   int64  `json:"updated_at"`
		ReadyCount int64 `json:"ready_count"`
		PendingCount int64 `json:"pending_count"`
		FailedCount int64 `json:"failed_count"`
	}
	AiKbDocInfo {
		Id             int64  `json:"id"`
		KbId           int64  `json:"kb_id"`
		Title          string `json:"title"`
		Status         string `json:"status"`
		Error          string `json:"error"`
		ChunkCount     int64  `json:"chunk_count"`
		EmbeddingModel string `json:"embedding_model"`
		CreatedAt      int64  `json:"created_at"`
		UpdatedAt      int64  `json:"updated_at"`
		Version        int64 `json:"version"`
		Stage          string `json:"stage"`
	}
	AiCreateKbReq {
		Name        string `json:"name" validate:"required,max=128"`
		Description string `json:"description,optional" validate:"omitempty,max=512"`
	}
	AiKbResp {
		Kb *AiKbInfo `json:"kb"`
		Capabilities *AiCapabilities `json:"capabilities"`
	}
	AiListKbsReq {
		Page int64 `form:"page,optional" validate:"omitempty,min=1"`
		PageSize int64 `form:"page_size,optional" validate:"omitempty,min=1,max=100"`
		Query string `form:"query,optional" validate:"omitempty,max=128"`
	}
	AiListKbsResp {
		List  []*AiKbInfo `json:"list"`
		Total int64       `json:"total"`
		Capabilities *AiCapabilities `json:"capabilities"`
	}
	AiSearchKbReq {
		Id    int64  `path:"id" validate:"min=1"`
		Query string `json:"query" validate:"required,maxbytes=2000"`
	}
	AiKbSearchHit {
		ChunkId  int64   `json:"chunk_id"`
		KbId     int64   `json:"kb_id"`
		DocId    int64   `json:"doc_id"`
		DocTitle string  `json:"doc_title"`
		Snippet  string  `json:"snippet"`
		Score    float32 `json:"score"`
	}
	AiSearchKbResp {
		List      []*AiKbSearchHit `json:"list"`
		ElapsedMs int64            `json:"elapsed_ms"`
	}
	AiUpdateKbReq {
		Id          int64   `path:"id" validate:"min=1"`
		Name        *string `json:"name,optional" validate:"omitempty,max=128"`
		Description *string `json:"description,optional" validate:"omitempty,max=512"`
	}
	AiCreateKbDocReq {
		Id      int64  `path:"id" validate:"min=1"`
		Title   string `json:"title" validate:"required,max=128"`
		Content string `json:"content" validate:"required,maxbytes=65536"`
		RequestId string `json:"request_id" validate:"required,uuid"`
		BatchId string `json:"batch_id,optional" validate:"omitempty,uuid"`
	}
	AiKbDocListReq {
		Id       int64 `path:"id" validate:"min=1"`
		Page     int64 `form:"page,optional" validate:"omitempty,min=1"`
		PageSize int64 `form:"page_size,optional" validate:"omitempty,min=1,max=100"`
		Query string `form:"query,optional" validate:"omitempty,max=128"`
		Status string `form:"status,optional" validate:"omitempty,oneof=pending ready failed"`
	}
	AiKbDocReq {
		Id    int64 `path:"id" validate:"min=1"`
		DocId int64 `path:"doc_id" validate:"min=1"`
	}
	AiGetKbDocReq {
		Id int64 `path:"id" validate:"min=1"`
		DocId int64 `path:"doc_id" validate:"min=1"`
		MetaOnly bool `form:"meta_only,optional"`
	}
	AiUpdateKbDocReq {
		Id int64 `path:"id" validate:"min=1"`
		DocId int64 `path:"doc_id" validate:"min=1"`
		Title string `json:"title" validate:"required,max=128"`
		Content string `json:"content" validate:"required,maxbytes=65536"`
		ExpectedVersion int64 `json:"expected_version" validate:"min=1"`
		RequestId string `json:"request_id" validate:"required,uuid"`
		BatchId string `json:"batch_id,optional" validate:"omitempty,uuid"`
	}
	AiRetryKbDocReq {
		Id int64 `path:"id" validate:"min=1"`
		DocId int64 `path:"doc_id" validate:"min=1"`
		RequestId string `json:"request_id" validate:"required,uuid"`
		BatchId string `json:"batch_id,optional" validate:"omitempty,uuid"`
	}
	AiKbDocDetailResp {
		Doc *AiKbDocInfo `json:"doc"`
		Content string `json:"content"`
	}
	AiKbDocResp {
		Doc *AiKbDocInfo `json:"doc"`
		JobId int64 `json:"job_id"`
		BatchId string `json:"batch_id"`
	}
	AiListKbDocsResp {
		List  []*AiKbDocInfo `json:"list"`
		Total int64          `json:"total"`
		ReadyCount int64 `json:"ready_count"`
		PendingCount int64 `json:"pending_count"`
		FailedCount int64 `json:"failed_count"`
	}
	AiKbImportListReq {
		Id int64 `path:"id" validate:"min=1"`
		Page int64 `form:"page,optional" validate:"omitempty,min=1"`
		PageSize int64 `form:"page_size,optional" validate:"omitempty,min=1,max=100"`
	}
	AiKbImportReq {
		Id int64 `path:"id" validate:"min=1"`
		BatchId string `path:"batch_id" validate:"required,uuid"`
	}
	AiKbIngestBatchInfo {
		Id string `json:"id"`
		KbId int64 `json:"kb_id"`
		Stopped bool `json:"stopped"`
		Total int64 `json:"total"`
		Queued int64 `json:"queued"`
		Running int64 `json:"running"`
		Succeeded int64 `json:"succeeded"`
		Failed int64 `json:"failed"`
		Cancelled int64 `json:"cancelled"`
		Reused int64 `json:"reused"`
		CreatedAt int64 `json:"created_at"`
		UpdatedAt int64 `json:"updated_at"`
	}
	AiKbIngestJobInfo {
		Id int64 `json:"id"`
		RequestId string `json:"request_id"`
		DocId int64 `json:"doc_id"`
		Operation string `json:"operation"`
		Status string `json:"status"`
		Error string `json:"error"`
		Doc *AiKbDocInfo `json:"doc"`
		CreatedAt int64 `json:"created_at"`
		UpdatedAt int64 `json:"updated_at"`
	}
	AiListKbImportsResp {
		List []*AiKbIngestBatchInfo `json:"list"`
		Total int64 `json:"total"`
	}
	AiKbImportResp {
		Batch *AiKbIngestBatchInfo `json:"batch"`
		List []*AiKbIngestJobInfo `json:"list"`
	}
)

@server (
	prefix:  v1/sys/ai
	group:   ai
	timeout: 120s
)
service admin {
	@handler createConversation
	post /conversations (AiCreateConversationReq) returns (AiConversationResp)

	@handler listConversations
	get /conversations (AiListConversationsReq) returns (AiListConversationsResp)

	@handler updateConversation
	put /conversations/:id (AiUpdateConversationReq) returns (AiConversationResp)

	@handler setMessageFeedback
	put /conversations/:id/messages/:message_id/feedback (AiMessageFeedbackReq) returns (EmptyResp)

	@handler getConversation
	get /conversations/:id (AiGetConversationReq) returns (AiGetConversationResp)

	@handler deleteConversation
	delete /conversations/:id (AiIdReq) returns (EmptyResp)

	@handler listTools
	get /tools (AiListToolsReq) returns (AiListToolsResp)

	@handler createWorkflow
	post /workflows (AiCreateWorkflowReq) returns (AiWorkflowResp)

	@handler listWorkflows
	get /workflows (AiListWorkflowsReq) returns (AiListWorkflowsResp)

	@handler getWorkflow
	get /workflows/:id (AiIdReq) returns (AiWorkflowResp)

	@handler updateWorkflow
	put /workflows/:id (AiUpdateWorkflowReq) returns (EmptyResp)

	@handler deleteWorkflow
	delete /workflows/:id (AiIdReq) returns (EmptyResp)

	@handler runWorkflow
	post /workflows/:id/run (AiRunWorkflowReq) returns (AiRunWorkflowResp)

	@handler runDraft
	post /tasks/run (AiRunDraftReq) returns (AiRunWorkflowResp)

	@handler listAgentTasks
	get /tasks (AiListTasksReq) returns (AiListTasksResp)

	@handler getAgentTask
	get /tasks/:id (AiGetTaskReq) returns (AiTaskResp)

	@handler approveTask
	post /tasks/:id/approve (AiApproveTaskReq) returns (EmptyResp)

	@handler cancelTask
	post /tasks/:id/cancel (AiIdReq) returns (EmptyResp)

	@handler createKb
	post /kbs (AiCreateKbReq) returns (AiKbResp)

	@handler listKbs
	get /kbs (AiListKbsReq) returns (AiListKbsResp)

	@handler getKb
	get /kbs/:id (AiIdReq) returns (AiKbResp)

	@handler searchKb
	post /kbs/:id/search (AiSearchKbReq) returns (AiSearchKbResp)

	@handler updateKb
	put /kbs/:id (AiUpdateKbReq) returns (EmptyResp)

	@handler deleteKb
	delete /kbs/:id (AiIdReq) returns (EmptyResp)

	@handler createKbDoc
	post /kbs/:id/docs (AiCreateKbDocReq) returns (AiKbDocResp)

	@handler listKbDocs
	get /kbs/:id/docs (AiKbDocListReq) returns (AiListKbDocsResp)

	@handler getKbDoc
	get /kbs/:id/docs/:doc_id (AiGetKbDocReq) returns (AiKbDocDetailResp)

	@handler updateKbDoc
	put /kbs/:id/docs/:doc_id (AiUpdateKbDocReq) returns (AiKbDocResp)

	@handler deleteKbDoc
	delete /kbs/:id/docs/:doc_id (AiKbDocReq) returns (EmptyResp)

	@handler retryKbDoc
	post /kbs/:id/docs/:doc_id/retry (AiRetryKbDocReq) returns (AiKbDocResp)

	@handler listKbImports
	get /kbs/:id/imports (AiKbImportListReq) returns (AiListKbImportsResp)

	@handler getKbImport
	get /kbs/:id/imports/:batch_id (AiKbImportReq) returns (AiKbImportResp)

	@handler stopKbImport
	post /kbs/:id/imports/:batch_id/stop (AiKbImportReq) returns (AiKbImportResp)

	@handler rejectTask
	post /tasks/:id/reject (AiRejectTaskReq) returns (EmptyResp)
}

@server (
	prefix:  v1/sys/ai
	group:   ai
	timeout: 120s
	sse:     true
)
service admin {
	// 流式发送：实际响应为 SSE（text/event-stream），不走统一 JSON 信封；AiSendMessageResp 仅作生成占位
	@handler sendMessageStream
	post /messages/stream (AiSendMessageReq) returns (AiSendMessageResp)
}
