syntax = "v1"

info (
	title:   "部门管理"
	version: "v1"
)

type (
    DeptInfo {
        Id        int64  `json:"id"`
        ParentId  int64  `json:"parent_id"`
        Name      string `json:"name"`
        Leader    string `json:"leader"`
        Phone     string `json:"phone"`
        Email     string `json:"email"`
        Sort      int32  `json:"sort"`
        Status    int32  `json:"status"`
        Path      string `json:"path"`
        CreatedAt int64  `json:"created_at"`
    }

    GetDeptTreeReq {
        Status int32 `json:"status,optional" form:"status,optional"`
    }
    GetDeptTreeResp {
        List []*DeptInfo `json:"list"`
    }

    CreateDeptReq {
        ParentId int64  `json:"parent_id,optional"`
        Name     string `json:"name"`
        Leader   string `json:"leader,optional"`
        Phone    string `json:"phone,optional"`
        Email    string `json:"email,optional"`
        Sort     int32  `json:"sort,optional"`
        Status   int32  `json:"status,optional"`
    }

    UpdateDeptReq {
        Id       int64  `path:"id"`
        ParentId int64  `json:"parent_id,optional"`
        Name     string `json:"name,optional"`
        Leader   string `json:"leader,optional"`
        Phone    string `json:"phone,optional"`
        Email    string `json:"email,optional"`
        Sort     int32  `json:"sort,optional"`
        Status   int32  `json:"status,optional"`
    }

    DeleteDeptReq {
        Id int64 `path:"id"`
    }
)

@server (
	prefix: v1/sys/dept
	group:  dept
	jwt:    Auth
)
service admin {
	@handler getDeptTree
	get /tree (GetDeptTreeReq) returns (GetDeptTreeResp)

	@handler createDept
	post /create (CreateDeptReq)

	@handler updateDept
	put /:id (UpdateDeptReq)

	@handler deleteDept
	delete /:id (DeleteDeptReq)
}
