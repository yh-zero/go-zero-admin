syntax = "v1"

info (
	title:   "文件资源管理"
	version: "v1"
)

type (
    FileInfo {
        Id           int64  `json:"id"`
        Bucket       string `json:"bucket"`
        ObjectKey    string `json:"object_key"`
        OriginalName string `json:"original_name"`
        Ext          string `json:"ext"`
        Mime         string `json:"mime"`
        Size         int64  `json:"size"`
        Visibility   string `json:"visibility"`
        RefCount     int32  `json:"ref_count"`
        UploaderId   int64  `json:"uploader_id"`
        URL          string `json:"url,optional""`
        CreatedAt    int64  `json:"created_at"`
    }

    GetFileListReq {
        Page       int64  `json:"page,optional" form:"page,optional"`
        PageSize   int64  `json:"page_size,optional" form:"page_size,optional"`
        Visibility string `json:"visibility,optional" form:"visibility,optional"`
        UploaderId int64  `json:"uploader_id,optional" form:"uploader_id,optional"`
    }
    GetFileListResp {
        List  []*FileInfo `json:"list"`
        Total int64        `json:"total"`
    }

    GetFileURLReq {
        Id int64 `path:"id"`
    }
    GetFileURLResp {
        URL       string `json:"url"`
        ExpiresAt int64  `json:"expires_at"`
    }

    DeleteFileReq {
        Id int64 `path:"id"`
    }
)

@server (
	prefix: v1/sys/file
	group:  file
	jwt:    Auth
)
service admin {
	@handler getFileList
	get /list (GetFileListReq) returns (GetFileListResp)

	@handler getFileURL
	get /:id/url (GetFileURLReq) returns (GetFileURLResp)

	@handler deleteFile
	delete /:id (DeleteFileReq)

}
