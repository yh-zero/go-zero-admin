syntax = "v1"

type (
	TenantInfo {
		Id                int64  `json:"id"`
		Slug              string `json:"slug"`
		Domain            string `json:"domain"`
		ComposeProject    string `json:"compose_project"`
		Status            string `json:"status"`
		ErrorMsg          string `json:"error_msg"`
		CreatedBy         int64  `json:"created_by"`
		CreatedAt         int64  `json:"created_at"`
		UpdatedAt         int64  `json:"updated_at"`
		AdminAccountReady bool   `json:"admin_account_ready"`
	}
	CreateTenantReq {
		Slug          string `json:"slug" validate:"min=2,max=32"`
		AdminUsername string `json:"admin_username,optional" validate:"omitempty,max=64"`
		AdminPassword string `json:"admin_password,optional" validate:"omitempty,maxbytes=72"`
	}
	CreateTenantResp {
		Tenant        *TenantInfo `json:"tenant"`
		AdminPassword string      `json:"admin_password"`
	}
	GetTenantListReq {
		Page     int64  `form:"page,default=1" validate:"omitempty,min=1"`
		PageSize int64  `form:"page_size,default=20" validate:"omitempty,min=1,max=100"`
		Status   string `form:"status,optional" validate:"omitempty,oneof=active stopped error"`
	}
	GetTenantListResp {
		List  []*TenantInfo `json:"list"`
		Total int64         `json:"total"`
	}
	TenantIdReq {
		Id int64 `path:"id" validate:"min=1"`
	}
	GetTenantResp {
		Tenant *TenantInfo `json:"tenant"`
	}
	DeleteTenantReq {
		Id          int64  `path:"id" validate:"min=1"`
		ConfirmSlug string `json:"confirm_slug" validate:"max=32"`
	}
	ResetTenantAdminResp {
		NewPassword string `json:"new_password"`
	}
)

@server (
	prefix:  v1/sys/tenant
	group:   tenant
	timeout: 120s
)
service admin {
	@handler createTenant
	post /create (CreateTenantReq) returns (CreateTenantResp)

	@handler getTenantList
	get /list (GetTenantListReq) returns (GetTenantListResp)

	@handler getTenant
	get /:id (TenantIdReq) returns (GetTenantResp)

	@handler startTenant
	post /:id/start (TenantIdReq) returns (EmptyResp)

	@handler stopTenant
	post /:id/stop (TenantIdReq) returns (EmptyResp)

	@handler deleteTenant
	delete /:id (DeleteTenantReq) returns (EmptyResp)

	@handler resetTenantAdmin
	post /:id/reset-admin (TenantIdReq) returns (ResetTenantAdminResp)
}
