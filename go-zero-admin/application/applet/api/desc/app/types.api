syntax = "v1"

import "../sys_base/user_struct.api"

type AppUser {
    AvatarURL string `json:"avatarUrl"`
    IdentityVerified bool `json:"identityVerified"`
    RegistrationIP string `json:"registrationIP"`
    RegistrationRegion string `json:"registrationRegion"`
    ID int64 `json:"id"`
    Account string `json:"account"`
    IdentityKind string `json:"identityKind"`
    Nickname string `json:"nickname"`
    Status string `json:"status"`
    ReviewReason string `json:"reviewReason"`
    CreatedAt string `json:"createdAt"`
    UpdatedAt string `json:"updatedAt"`
}

type AppRegisterRequest {
    EmailCode string `json:"emailCode,optional"`
    Account string `json:"account"`
    Password string `json:"password"`
    Nickname string `json:"nickname,optional"`
}

type AppSendEmailCodeRequest {
    Account string `json:"account"`
}
type AppAuthOptions {
    EmailVerificationRequired bool `json:"emailVerificationRequired"`
    EmailCodeEnabled bool `json:"emailCodeEnabled"`
}
type AppLoginRequest {
    Account string `json:"account"`
    Password string `json:"password"`
}

type AppRefreshRequest {
    RefreshToken string `json:"refreshToken"`
}

type AppAuthTokens {
    AccessToken string `json:"accessToken"`
    RefreshToken string `json:"refreshToken"`
    ExpiresAt int64 `json:"expiresAt"`
    RefreshExpiresAt int64 `json:"refreshExpiresAt"`
    User AppUser `json:"user"`
}

type AppProfileRequest {
    Nickname string `json:"nickname"`
}

type AppLogoutRequest {
    AllDevices bool `json:"allDevices,optional"`
}

type AppSessionIDRequest {
    ID string `json:"id"`
}

type AppSession {
    ID string `json:"id"`
    UserID int64 `json:"userId"`
    IP string `json:"ip"`
    UserAgent string `json:"userAgent"`
    CreatedAt string `json:"createdAt"`
    ExpiresAt string `json:"expiresAt"`
    Current bool `json:"current"`
}

type AppSessionList {
    List []AppSession `json:"list"`
}

type AppUserListRequest {
    PageNo int64 `form:"pageNo,default=1"`
    PageSize int64 `form:"pageSize,default=10"`
    Keyword string `form:"keyword,optional"`
    Status string `form:"status,optional"`
}

type AppUserList {
    List []AppUser `json:"list"`
    Total int64 `json:"total"`
    PageNo int64 `json:"pageNo"`
    PageSize int64 `json:"pageSize"`
}

type AppStatusRequest {
    UserID int64 `json:"userId"`
    Status string `json:"status"`
    Reason string `json:"reason"`
}

type AppAvatarRequest {
    UserID int64 `json:"userId"`
    AvatarURL string `json:"avatarUrl"`
}

type AppUserIDRequest {
    UserID int64 `form:"userId"`
}

type AppPlan {
    ID int64 `json:"id"`
    Code string `json:"code"`
    Name string `json:"name"`
    Version int64 `json:"version"`
    Entitlements []string `json:"entitlements"`
}

type AppPlanList {
    List []AppPlan `json:"list"`
}

type AppGrant {
    ID int64 `json:"id"`
    UserID int64 `json:"userId"`
    Account string `json:"account"`
    PlanID int64 `json:"planId"`
    PlanCode string `json:"planCode"`
    PlanVersion int64 `json:"planVersion"`
    Entitlements []string `json:"entitlements"`
    StartsAt string `json:"startsAt"`
    EndsAt string `json:"endsAt"`
    RevokedAt string `json:"revokedAt"`
    Reason string `json:"reason"`
    RevokeReason string `json:"revokeReason"`
    CreatedAt string `json:"createdAt"`
    Status string `json:"status"`
}

type AppGrantListRequest {
    PageNo int64 `form:"pageNo,default=1"`
    PageSize int64 `form:"pageSize,default=10"`
    UserID int64 `form:"userId,optional"`
}

type AppGrantList {
    List []AppGrant `json:"list"`
    Total int64 `json:"total"`
    PageNo int64 `json:"pageNo"`
    PageSize int64 `json:"pageSize"`
}

type AppGrantRequest {
    UserID int64 `json:"userId"`
    PlanID int64 `json:"planId"`
    Days int64 `json:"days"`
    RequestID string `json:"requestId"`
    Reason string `json:"reason"`
}

type AppGrantRevokeRequest {
    ID int64 `json:"id"`
    Reason string `json:"reason"`
}

type AppMembership {
    Active bool `json:"active"`
    ExpiresAt string `json:"expiresAt"`
    Entitlements []string `json:"entitlements"`
}

type AppExample {
    UserID int64 `json:"userId"`
    Account string `json:"account"`
    Nickname string `json:"nickname"`
    GeneratedAt string `json:"generatedAt"`
}

