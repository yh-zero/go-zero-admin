FROM alpine:3.22
RUN apk add --no-cache aws-cli curl jq ca-certificates
COPY docker/storage-init.sh /usr/local/bin/storage-init
COPY data/demo-files/*.png /opt/gozero/demo-files/
RUN sed -i 's/\r$//' /usr/local/bin/storage-init && chmod +x /usr/local/bin/storage-init
ENTRYPOINT ["/usr/local/bin/storage-init"]
