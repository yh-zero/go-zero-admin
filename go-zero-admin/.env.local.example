# 复制本文件为 .env.local（同目录）并填写真实值；docker compose 启动时经 env_file 自动读取 .env.local。
# 变量对应 yaml 中的 ${VAR} 占位符（application/*/etc/*.yaml 与 docker/etc/*.yaml 双套配置共用）。
# .env.local 已 gitignore，不会提交；本文件仅为变量说明模板。

# AI 模型密钥：按 ai.yaml 中 AI.Provider 选用其一；不配则 AI 接口返回降级提示，不影响其他功能
AI_DEEPSEEK_KEY=
AI_QWEN_KEY=

# SMTP 邮件：app-rpc 发送验证码用；不配则邮件功能降级
APP_SMTP_USERNAME=
APP_SMTP_PASSWORD=
# 留空时发件地址回退到 APP_SMTP_USERNAME；两套 YAML 默认 smtp.163.com:465，使用隐式 TLS。
APP_SMTP_FROM=
