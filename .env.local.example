# Copy this file to .env.local in the backend root for local development.
# test/sh/dev.ps1 loads .env.local on Start/Restart; existing process values win.
# Keep real keys in .env.local only. This template must contain no real secrets.
# Model keys are passed only to the separate ai-rpc process on port 6002.
# Values are literal: no variable expansion or shell execution; use whole-line comments.

# AI switch, provider, model, endpoint and limits belong in:
# application/ai/rpc/etc/ai.yaml (AI section). AI is disabled by default.
# Fill only the key for the provider selected in AI.Provider, then run dev.ps1 Restart.
# Legacy AI_AGENT_*, *_MODEL and *_BASE_URL environment variables are not used.

# DeepSeek key (AI.Provider: deepseek).
DEEPSEEK_API_KEY=

# Qwen key (AI.Provider: qwen); choose the account region endpoint in ai.yaml.
QWEN_API_KEY=
